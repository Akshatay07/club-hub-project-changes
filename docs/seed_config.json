{
  "database": "MongoDB",
  "schemas": {
    "User": {
      "name": { "type": "String", "required": true, "trim": true },
      "email": { "type": "String", "required": true, "unique": true, "lowercase": true, "trim": true },
      "password": { "type": "String", "required": true },
      "role": { "type": "String", "enum": ["student", "faculty", "admin"], "default": "student" },
      "regNo": { "type": "String", "default": "" },
      "studentId": { "type": "String", "default": "" },
      "department": { "type": "String", "default": "" },
      "year": { "type": "String", "default": "" },
      "assignedClubs": [{ "type": "ObjectId", "ref": "Club" }],
      "emailVerified": { "type": "Boolean", "default": false },
      "isApproved": { "type": "Boolean", "default": true },
      "otp": { "type": "String", "default": null },
      "otpExpiry": { "type": "Date", "default": null },
      "resetToken": { "type": "String", "default": null },
      "resetTokenExpiry": { "type": "Date", "default": null }
    },
    "Club": {
      "name": { "type": "String", "required": true, "unique": true, "trim": true },
      "description": { "type": "String", "default": "" },
      "category": { "type": "String", "enum": ["technical", "cultural", "sports", "arts", "social", "other"], "default": "other" },
      "members": [{ "type": "ObjectId", "ref": "User" }],
      "facultyIds": [{ "type": "ObjectId", "ref": "User" }],
      "budgetAllocated": { "type": "Number", "default": 0 },
      "budgetUsed": { "type": "Number", "default": 0 },
      "budgetPending": { "type": "Number", "default": 0 },
      "rating": { "type": "Number", "default": 0 },
      "healthScore": { "type": "Number", "default": 0 },
      "healthStatus": { "type": "String", "enum": ["healthy", "warning", "critical"], "default": "critical" },
      "membersCount": { "type": "Number", "default": 0 },
      "plannedEvents": { "type": "Number", "default": 0 },
      "eventCount": { "type": "Number", "default": 0 },
      "participationRate": { "type": "Number", "default": 0 },
      "attendanceRate": { "type": "Number", "default": 0 },
      "proofSubmissionRate": { "type": "Number", "default": 0 },
      "budgetEfficiency": { "type": "Number", "default": 0 }
    },
    "Event": {
      "name": { "type": "String", "required": true, "trim": true },
      "description": { "type": "String", "default": "" },
      "clubId": { "type": "ObjectId", "ref": "Club", "required": true },
      "clubName": { "type": "String", "default": "" },
      "facultyId": { "type": "ObjectId", "ref": "User", "required": true },
      "date": { "type": "String", "required": true },
      "time": { "type": "String", "required": true },
      "endTime": { "type": "String", "default": "" },
      "location": { "type": "String", "default": "" },
      "venue": { "type": "String", "default": "" },
      "type": { "type": "String", "default": "" },
      "maxCapacity": { "type": "Number", "default": 100 },
      "registeredCount": { "type": "Number", "default": 0 },
      "attendanceCount": { "type": "Number", "default": 0 },
      "status": { "type": "String", "enum": ["pending", "approved", "rejected", "postponed"], "default": "pending" },
      "qrCode": { "type": "String", "default": null }
    },
    "EventRegistration": {
      "eventId": { "type": "ObjectId", "ref": "Event", "required": true },
      "studentId": { "type": "ObjectId", "ref": "User", "required": true },
      "confirmationCode": { "type": "String", "required": true },
      "status": { "type": "String", "enum": ["registered", "attended", "absent", "cancelled"], "default": "registered" }
    },
    "Feedback": {
      "studentId": { "type": "ObjectId", "ref": "User", "required": true },
      "targetType": { "type": "String", "enum": ["club", "event"], "required": true },
      "targetId": { "type": "ObjectId", "required": true },
      "rating": { "type": "Number", "required": true, "min": 1, "max": 5 },
      "comment": { "type": "String", "default": "" }
    },
    "Notification": {
      "userId": { "type": "ObjectId", "ref": "User", "required": true },
      "title": { "type": "String", "required": true },
      "description": { "type": "String", "default": "" },
      "type": { "type": "String", "enum": ["info", "success", "warning", "error"], "default": "info" },
      "read": { "type": "Boolean", "default": false }
    },
    "Complaint": {
      "studentId": { "type": "ObjectId", "ref": "User", "required": true },
      "content": { "type": "String", "required": true },
      "type": { "type": "String", "enum": ["facility", "rating", "alert", "other"], "default": "other" },
      "status": { "type": "String", "enum": ["open", "in-progress", "resolved"], "default": "open" }
    },
    "Budget": {
      "purpose": { "type": "String", "required": true },
      "amount": { "type": "Number", "required": true },
      "clubId": { "type": "ObjectId", "ref": "Club", "required": true },
      "facultyId": { "type": "ObjectId", "ref": "User", "required": true },
      "status": { "type": "String", "enum": ["pending", "approved", "rejected"], "default": "pending" }
    }
  },
